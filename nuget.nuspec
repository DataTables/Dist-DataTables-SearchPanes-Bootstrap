<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>2.3.5</version>
        <id>datatables.net-searchpanes-bs</id>
        <description>This is SearchPanes for DataTables with styling for [Bootstrap](https://getbootstrap.com/docs/3.3/)</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>SearchPanes  search  filtering  Bootstrap  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-searchpanes" version="3.0.0-beta.1"/>
            <dependency id="datatables.net-bs" version="^3"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/searchPanes.bootstrap.js" target="content\Scripts"/>
        <file src="js/searchPanes.bootstrap.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.bootstrap.min.js" target="content\Scripts"/>
        <file src="js/searchPanes.bootstrap.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.bootstrap.min.mjs" target="content\Scripts"/>
        <file src="js/searchPanes.bootstrap.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.bootstrap.mjs" target="content\Scripts"/>
        <file src="js/searchPanes.bootstrap.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/searchPanes.bootstrap.css" target="content\Content"/>
        <file src="css/searchPanes.bootstrap.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/searchPanes.bootstrap.min.css" target="content\Content"/>
        <file src="css/searchPanes.bootstrap.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
